# Ports and toolchain for the local dev stack. Sourced by scripts/*.sh.
# Override any value from the shell: BACKEND_PORT=8081 scripts/dev-up.sh
# DB_PORT is the host port compose publishes (docker-compose.yml reads it).
DB_PORT=${DB_PORT:-5433}
BACKEND_PORT=${BACKEND_PORT:-8080}
FRONTEND_PORT=${FRONTEND_PORT:-3000}
# Backend needs JDK 17 (the default java on this machine is 25).
JAVA_HOME=$HOME/.sdkman/candidates/java/17.0.15-tem
# User created by seed.sh and used by the smoke test (same as app.local-dev.email).
SEED_EMAIL=${SEED_EMAIL:-juanmgracia@gmail.com}
SEED_NAME=${SEED_NAME:-Juan Gracia}
# Own compose project so this stack gets its own volume (the default project name proppilot-backend
# is shared with every other checkout and may hold unrelated data).
COMPOSE_PROJECT=${COMPOSE_PROJECT:-proppilot-cold}
# Container name; compose reads it too (container_name and host port come from env in docker-compose.yml).
# A second stack needs its own COMPOSE_PROJECT, PG_CONTAINER, DB_PORT, BACKEND_PORT and FRONTEND_PORT.
PG_CONTAINER=${PG_CONTAINER:-proppilot-postgres}
