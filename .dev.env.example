# Copy to .dev.env (gitignored) to override local dev settings. Read by scripts/*.sh.
# Host port for the proppilot-postgres container. Change it if 5433 is taken.
POSTGRES_PORT=5433
# Force a JDK for the backend (must be 17 or 21; Lombok in Spring Boot 3.2 breaks on 25).
# PROPPILOT_JAVA_HOME=/path/to/jdk-17
